# Copy to functions/.env (git-ignored) for local emulator use only.
# In deployed Cloud Functions, these two non-secret values come from this
# file (or `firebase functions:config`), while the four secret values below
# are set separately with `firebase functions:secrets:set NAME` - never put
# real Daraja consumer key/secret/passkey/shortcode in this file.

# Sandbox during development; https://api.safaricom.co.ke once Safaricom
# approves production Go-Live.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke

# Only known after the FIRST deploy of mpesaCallback - deploy once to get
# the URL Firebase prints, set it here (or via functions:config), redeploy.
# Format: https://us-central1-yobrapulse-a0389.cloudfunctions.net/mpesaCallback
MPESA_CALLBACK_URL=

# Secrets - set these with, e.g.:
#   firebase functions:secrets:set DARAJA_CONSUMER_KEY
# Do NOT put real values in this file.
#   DARAJA_CONSUMER_KEY
#   DARAJA_CONSUMER_SECRET
#   DARAJA_PASSKEY
#   DARAJA_SHORTCODE
